# Copy to .env.k3s for K3s deployment. Never commit .env.k3s.
# K3s reads Kubernetes Secrets, not this file directly.
KUBE_CONTEXT=brownrook-k3s1
KUBE_NAMESPACE=home-budget

# OCR cache on the K3s PV. make deploy-k3s writes receipt-runtime-config.
# Mac development uses its own local cache configured in .env.dev.
HOME_BUDGET_OCR_CACHE=/data/receipts/derived/ocr-cache

# RabbitMQ: rabbitmq-secret. For an existing broker, use its current credentials.
RABBITMQ_DEFAULT_USER=receipts
# Generate with: openssl rand -hex 32
RABBITMQ_DEFAULT_PASS=

# Entra: ledger-oauth2-proxy-secret. Same app registration as local development.
ENTRA_TENANT_ID=
OAUTH2_PROXY_CLIENT_ID=
OAUTH2_PROXY_CLIENT_SECRET=
# Retrieve the existing K3s cookie secret; keep it separate from the Mac cookie.
OAUTH2_PROXY_COOKIE_SECRET=

# PostgreSQL: postgres-secret. Set the desired password here.
POSTGRES_DB=home_budget
POSTGRES_USER=home_budget
POSTGRES_PASSWORD=
POSTGRES_HOST=postgres.brownrook.net
POSTGRES_PORT=5432
# The deployment reader expands these references and URL-encodes credentials.
DATABASE_URL='postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}'
HOME_BUDGET_PG_DSN='${DATABASE_URL}'
# Quote values containing spaces or # with single quotes.
# make deploy-k3s uses this password, then starts the Argo CD deployment.
# An unchanged password is reused. Changing this value updates the existing DB.
# Deployment uses DATABASE_URL and HOME_BUDGET_PG_DSN from this file.
# Do not copy the Mac's localhost DATABASE_URL.

# Product enrichment: brave-search-api and openai-api, respectively.
BRAVE_SEARCH_API_KEY=
OPENAI_API_KEY=

# GitHub Container Registry: ghcr-secret. Keep the token outside Git.
GHCR_USERNAME=larocquemb
GHCR_TOKEN=

# Storage uses the existing pve-smb-credentials Secret.
# Receipt paths, OCR options, and ingress hosts are configured in the manifests.
# TLS certificates/keys stay in the existing Kubernetes TLS secrets.
