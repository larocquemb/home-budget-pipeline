// Method B: collect only home-budget Pod logs through the Kubernetes API.
// The kubeconfig contains a dedicated, namespace-scoped service-account token
// and the K3s API CA. It must be mode 0640 and readable only by root:alloy.
discovery.kubernetes "home_budget_pods" {
  role            = "pod"
  kubeconfig_file = "/etc/alloy/home-budget.kubeconfig"

  namespaces {
    names = ["home-budget"]
  }
}

// Promote only bounded Kubernetes identity fields to Loki labels. Arbitrary
// Pod labels and annotations are deliberately not copied.
discovery.relabel "home_budget_pods" {
  targets = discovery.kubernetes.home_budget_pods.targets

  rule {
    source_labels = ["__meta_kubernetes_namespace"]
    action        = "replace"
    target_label  = "namespace"
  }

  rule {
    source_labels = ["__meta_kubernetes_pod_name"]
    action        = "replace"
    target_label  = "pod"
  }

  rule {
    source_labels = ["__meta_kubernetes_pod_container_name"]
    action        = "replace"
    target_label  = "container"
  }

  rule {
    source_labels = ["__meta_kubernetes_pod_node_name"]
    action        = "replace"
    target_label  = "node"
  }

  rule {
    source_labels = ["__meta_kubernetes_pod_label_app"]
    action        = "replace"
    target_label  = "app"
  }

  rule {
    source_labels = ["__meta_kubernetes_pod_label_app"]
    action        = "replace"
    target_label  = "service"
  }

  rule {
    source_labels = ["__meta_kubernetes_pod_label_app_kubernetes_io_name"]
    regex         = "(.+)"
    action        = "replace"
    replacement   = "$1"
    target_label  = "service"
  }

  rule {
    source_labels = ["__meta_kubernetes_namespace", "__meta_kubernetes_pod_container_name"]
    action        = "replace"
    separator     = "/"
    target_label  = "job"
  }
}

loki.source.kubernetes "home_budget" {
  targets    = discovery.relabel.home_budget_pods.output
  forward_to = [loki.process.home_budget.receiver]

  client {
    kubeconfig_file = "/etc/alloy/home-budget.kubeconfig"
  }
}

loki.process "home_budget" {
  stage.decolorize {}

  stage.static_labels {
    values = {
      cluster     = "brownrook-k3s1",
      environment = "production",
      collection  = "kubernetes-api",
    }
  }

  // Defense in depth. Applications remain responsible for never logging
  // credentials or personal information.
  stage.replace {
    expression = `(?i)postgres(ql)?://[^\s"']+`
    replace    = "postgresql://[REDACTED]"
  }

  stage.replace {
    expression = `(?i)(api[_-]?key|token|password)\s*[=:]\s*[^\s,;]+`
    replace    = "[REDACTED_CREDENTIAL]"
  }

  stage.replace {
    expression = `(?i)bearer\s+[^\s,;]+`
    replace    = "Bearer [REDACTED]"
  }

  forward_to = [loki.write.monitoring_tls.receiver]
}

loki.write "monitoring_tls" {
  endpoint {
    // Loki runs on the external monitoring host. The connection remains on
    // loopback but still validates its dedicated server certificate.
    url = "https://127.0.0.1:3100/loki/api/v1/push"

    tls_config {
      ca_file     = "/etc/alloy/brown-rook-root-ca.crt"
      cert_file   = "/etc/alloy/loki-client.crt"
      key_file    = "/etc/alloy/loki-client.key"
      server_name = "monitoring.idc.brownrook.net"
      min_version = "TLS12"
    }
  }

  wal {
    enabled = true
  }
}

// Receive application metrics and traces from the in-cluster Collector. Alloy
// is the only network-facing OTLP endpoint; the client CA makes the listener
// require a Brown Rook client identity.
otelcol.receiver.otlp "home_budget" {
  grpc {
    endpoint          = "0.0.0.0:4317"
    max_recv_msg_size = "4MiB"

    tls {
      cert_file     = "/etc/alloy/otel-server.crt"
      key_file      = "/etc/alloy/otel-server.key"
      client_ca_file = "/etc/alloy/brown-rook-root-ca.crt"
      // otelcol delegates this value to the upstream Collector TLS parser,
      // whose accepted version names differ from Alloy's native TLS blocks.
      min_version = "1.2"
    }
  }

  output {
    metrics = [otelcol.processor.memory_limiter.home_budget.input]
    traces  = [otelcol.processor.memory_limiter.home_budget.input]
  }
}

otelcol.processor.memory_limiter "home_budget" {
  check_interval = "1s"
  limit          = "256MiB"
  spike_limit    = "64MiB"

  output {
    metrics = [otelcol.processor.batch.home_budget.input]
    traces  = [otelcol.processor.batch.home_budget.input]
  }
}

otelcol.processor.batch "home_budget" {
  timeout             = "1s"
  send_batch_size     = 256
  send_batch_max_size = 512

  output {
    metrics = [otelcol.processor.transform.home_budget_metric_labels.input]
    traces  = [otelcol.exporter.otlp.tempo.input]
  }
}

// Copy only the bounded resource dimensions required by KAN-88 into metric
// datapoints. Avoid converting every resource attribute: pod names and UIDs
// would otherwise create a new Prometheus series on each rollout.
otelcol.processor.transform "home_budget_metric_labels" {
  error_mode = "ignore"

  metric_statements {
    context = "datapoint"
    statements = [
      `set(attributes["environment"], resource.attributes["deployment.environment.name"]) where resource.attributes["deployment.environment.name"] != nil`,
      `set(attributes["service"], resource.attributes["service.name"]) where resource.attributes["service.name"] != nil`,
      `set(attributes["worker_host"], resource.attributes["host.name"]) where resource.attributes["host.name"] != nil`,
      `set(attributes["worker_host"], resource.attributes["k8s.node.name"]) where resource.attributes["k8s.node.name"] != nil`,
    ]
  }

  output {
    metrics = [otelcol.exporter.prometheus.home_budget.input]
  }
}

// Prometheus's write receiver is bound to loopback, so only local Alloy can
// submit application metrics.
otelcol.exporter.prometheus "home_budget" {
  forward_to = [prometheus.remote_write.local_prometheus.receiver]
}

prometheus.remote_write "local_prometheus" {
  endpoint {
    url = "http://127.0.0.1:9090/api/v1/write"

    queue_config {
      capacity             = 2048
      max_samples_per_send = 512
      max_shards           = 2
    }
  }
}

// Tempo's ingest listener is loopback-only. Keep this exporter synchronous so
// failures propagate to the Collector's persistent sending queue.
otelcol.exporter.otlp "tempo" {
  sending_queue {
    enabled = false
  }

  client {
    endpoint = "127.0.0.1:14317"

    tls {
      insecure = true
    }
  }
}
