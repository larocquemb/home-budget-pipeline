# Copy to .env.dev and fill in the values. Never commit .env.dev.
# Export assignments for CLI commands: set -a; source .env.dev; set +a
ENTRA_TENANT_ID=
ENTRA_CLIENT_ID=
ENTRA_CLIENT_SECRET=
# Generate with: openssl rand -base64 32 | tr -- '+/' '-_'
OAUTH2_COOKIE_SECRET=
# Generate separately with: openssl rand -hex 32
# Caddy adds this to authenticated upstream requests so direct port 8080 access
# cannot impersonate OAuth2 Proxy identity headers.
LEDGER_PROXY_SECRET=

# KAN-137: backend containers run on Arsene; only HTTPS/Entra runs in local Colima.
# Generate .dev-backend/secrets.yml and use scripts/development_backend.py configure.
HOME_BUDGET_ENVIRONMENT=development
DATABASE_URL=postgresql://home_budget_dev:GENERATED_PASSWORD@arsene.brownrook.net:15432/home_budget_dev
# Isolated PostgreSQL test database retired; integration tests fail closed.
TEST_DATABASE_URL=
RABBITMQ_URL=amqp://home_budget_dev:GENERATED_PASSWORD@arsene.brownrook.net:15673/home-budget-dev
TEST_RABBITMQ_URL=amqp://home_budget_test:GENERATED_PASSWORD@arsene.brownrook.net:15673/home-budget-test
NEO4J_URI=bolt://arsene.brownrook.net:17687
NEO4J_USER=neo4j
NEO4J_PASSWORD=GENERATED_PASSWORD
NEO4J_DATABASE=neo4j
# Product enrichment requires a Brave Search API key.
BRAVE_SEARCH_API_KEY=
RECEIPT_SOURCE_ROOT=
ELECTRONIC_RECEIPT_SOURCE_ROOT=

# Mac-only OCR cache on local disk; K3s uses the cache on its PV.
# Relative to the repository root when running the CLI from this directory.
HOME_BUDGET_OCR_CACHE=.ocr_cache

# Optional local command output forwarding; make dev-telemetry-start sets this
# to the absolute .local-services directory and enables structured logs.
# HOME_BUDGET_LOCAL_LOG_DIR=/absolute/path/to/home-budget-pipeline/.local-services

# Shared Arsene GPU service for development and production inference.
OLLAMA_HOST=http://192.168.2.201:11434
OLLAMA_BASE_URL=http://192.168.2.201:11434
OLLAMA_GPU_METRICS_URL=http://192.168.2.201:11435/gpu
