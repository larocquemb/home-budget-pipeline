# Copy to .env.dev and fill in the values. Never commit .env.dev.
ENTRA_TENANT_ID=
ENTRA_CLIENT_ID=
ENTRA_CLIENT_SECRET=
# Generate with: openssl rand -base64 32 | tr -- '+/' '-_'
OAUTH2_COOKIE_SECRET=

# Ledger connects through a local PostgreSQL port-forward by default:
# kubectl -n home-budget port-forward svc/postgres 5433:5432
DATABASE_URL=postgresql://home_budget:CHANGE_ME@127.0.0.1:5433/home_budget
RECEIPT_SOURCE_ROOT=
