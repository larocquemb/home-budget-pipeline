# Copy to the repository root as .env.monitoring and use absolute paths.
# The external-log-reader kubeconfig is copied to Alloy; the admin kubeconfig
# is used only from this controller to reconcile the Kubernetes TLS Secret.
MONITORING_PKI_DIR=/Users/example/brownrook-ca
MONITORING_ALLOY_KUBECONFIG=/absolute/path/to/home-budget.kubeconfig
MONITORING_ADMIN_KUBECONFIG=/absolute/path/to/kubeconfig-with-brownrook-k3s1
MONITORING_GRAFANA_ADMIN_USER=admin

# Keep the Grafana password out of this file. The wrapper prompts for it.
# Set to 0 when SSH key authentication or passwordless sudo is configured.
MONITORING_ASK_SSH_PASSWORD=1
MONITORING_ASK_BECOME_PASSWORD=1
