      "panel-1": {
        "kind": "Panel",
        "spec": {
          "id": 1,
          "title": "Receipts processed (last 6 hours)",
          "description": "Aggregate completed receipt-processing attempts during the fixed public history window.",
          "links": [],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
                      "kind": "DataQuery",
                      "group": "prometheus",
                      "version": "v0",
                      "datasource": {
                        "name": "{{ monitoring_grafana_prometheus_datasource_uid }}"
                      },
                      "spec": {
                        "editorMode": "code",
                        "expr": "sum(increase(brownrook_receipt_processed_total[6h])) or vector(0)",
                        "instant": true,
                        "range": false
                      }
                    },
                    "refId": "A",
                    "hidden": false
                  }
                }
              ],
              "transformations": [],
              "queryOptions": {}
            }
          },
          "vizConfig": {
            "kind": "VizConfig",
            "group": "stat",
            "version": "13.2.1",
            "spec": {
              "options": {
                "colorMode": "value",
                "graphMode": "area",
                "reduceOptions": {
                  "calcs": [
                    "lastNotNull"
                  ],
                  "fields": "",
                  "values": false
                }
              },
              "fieldConfig": {
                "defaults": {
                  "unit": "short",
                  "decimals": 0,
                  "min": 0
