                      "version": "v0",
                      "datasource": {"name": "{{ monitoring_grafana_prometheus_datasource_uid }}"},
                      "spec": {
                        "editorMode": "code",
                        "expr": "sum by (destination) (rate(brownrook_ocr_collector_routed_total[$__rate_interval])) or vector(0)",
                        "legendFormat": "retry/dead routing"
