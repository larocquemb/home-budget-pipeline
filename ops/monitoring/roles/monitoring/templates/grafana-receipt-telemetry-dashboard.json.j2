                      "spec": {
                        "editorMode": "code",
                        "expr": "sum(rate(otelcol_exporter_send_failed_metric_points_total[$__rate_interval]))",
                        "legendFormat": "Collector failed metric points"
                      }
                    },
                    "refId": "A",
                    "hidden": false
                  }
