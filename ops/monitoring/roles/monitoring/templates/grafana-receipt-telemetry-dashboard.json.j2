      "panel-11": {
        "kind": "Panel",
        "spec": {
          "id": 11,
          "title": "OCR result collector throughput, latency, retries, failures and DLQ",
          "links": [],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
                      "kind": "DataQuery",
                      "group": "prometheus",
                      "version": "v0",
                      "datasource": {"name": "{{ monitoring_grafana_prometheus_datasource_uid }}"},
                      "spec": {
                        "editorMode": "code",
                        "expr": "sum by (event_type, outcome) (rate(brownrook_ocr_collector_events_total[$__rate_interval])) or vector(0)",
                        "legendFormat": "collector event outcome"
                      }
                    },
                    "refId": "A",
                    "hidden": false
                  }
                },
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
                      "kind": "DataQuery",
                      "group": "prometheus",
                      "version": "v0",
                      "datasource": {"name": "{{ monitoring_grafana_prometheus_datasource_uid }}"},
                      "spec": {
                        "editorMode": "code",
                        "expr": "histogram_quantile(0.95, sum by (event_type, le) (rate(brownrook_ocr_collector_persistence_duration_seconds_bucket[$__rate_interval]))) or vector(0)",
                        "legendFormat": "p95 persistence seconds"
                      }
                    },
                    "refId": "B",
                    "hidden": false
