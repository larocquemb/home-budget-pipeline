                      "group": "prometheus",
                      "version": "v0",
                      "datasource": {
                        "name": "{{ monitoring_grafana_prometheus_datasource_uid }}"
                      },
                      "spec": {
                        "editorMode": "code",
                        "expr": "sum(fluentbit_input_storage_chunks_up)",
                        "legendFormat": "Fluent Bit chunks in memory"
