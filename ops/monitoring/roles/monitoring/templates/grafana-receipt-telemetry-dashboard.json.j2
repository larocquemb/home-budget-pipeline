                      "version": "v0",
                      "datasource": {
                        "name": "{{ monitoring_grafana_prometheus_datasource_uid }}"
                      },
                      "spec": {
                        "editorMode": "code",
                        "expr": "sum(prometheus_remote_storage_samples_pending{job=\"alloy\",component_id=\"prometheus.remote_write.local_prometheus\"}) or vector(0)",
                        "legendFormat": "Alloy pending samples"
                      }
                    },
                    "refId": "F",
                    "hidden": false
