                      "spec": {
                        "editorMode": "code",
                        "expr": "rabbitmq_detailed_queue_messages{vhost=\"receipts\",queue=\"ocr.results.v1.dead\"} or vector(0)",
                        "legendFormat": "dead-letter depth"
                      }
