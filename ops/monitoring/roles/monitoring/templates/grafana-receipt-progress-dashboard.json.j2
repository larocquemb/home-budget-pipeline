{
  "apiVersion": "dashboard.grafana.app/v2",
  "kind": "Dashboard",
  "metadata": {
    "name": "home-budget-dev-progress",
    "annotations": {
      "grafana.app/folder": "{{ monitoring_grafana_home_budget_folder_uid_effective }}"
    }
  },
  "spec": {
    "annotations": [
      {
        "kind": "AnnotationQuery",
        "spec": {
          "query": {
            "kind": "DataQuery",
            "group": "grafana",
            "version": "v0",
            "datasource": {
              "name": "-- Grafana --"
            },
            "spec": {}
          },
          "enable": true,
          "hide": true,
          "iconColor": "rgba(0, 211, 255, 1)",
          "name": "Annotations & Alerts",
          "builtIn": true,
          "legacyOptions": {
            "type": "dashboard"
          }
        }
      }
    ],
    "cursorSync": "Crosshair",
    "description": "Select Environment to use the same panels and queries for development or production. Latest recorded cache-rebuild batch: confirmed receipts, waiting, running, cache completed, failed and unknown. Stale workers and historical queue observations that cannot be reconciled are unknown. Database receipt presence and actual queue ready-message counts are separate. Collector messages include OCR passes, not only receipts. Snapshots refresh every 10 seconds and expire after 45 seconds.",
    "editable": false,
    "elements": {
      "panel-1": {
        "kind": "Panel",
        "spec": {
          "id": 1,
          "title": "Work total",
          "links": [],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
                      "kind": "DataQuery",
                      "group": "loki",
                      "version": "v0",
                      "datasource": {
                        "name": "{{ monitoring_grafana_datasource_uid }}"
                      },
                      "spec": {
                        "expr": "last_over_time({environment=~\"${environment:regex}\", app=\"receipt-progress\"} | json event=\"event\", total=\"total\" | event=\"receipt_progress_snapshot\" | unwrap total | __error__=\"\" [45s])",
                        "queryType": "instant",
                        "editorMode": "code"
                      }
                    },
                    "refId": "A",
                    "hidden": false
                  }
                }
              ],
              "transformations": [],
              "queryOptions": {}
            }
          },
          "vizConfig": {
            "kind": "VizConfig",
            "group": "stat",
            "version": "13.2.1",
            "spec": {
              "options": {
                "colorMode": "value",
                "graphMode": "none",
                "reduceOptions": {
                  "calcs": [
                    "lastNotNull"
                  ],
                  "fields": "",
                  "values": false
                }
              },
              "fieldConfig": {
                "defaults": {
                  "unit": "short",
                  "decimals": 0,
                  "min": 0,
                  "noValue": "Unavailable",
                  "color": {
                    "mode": "fixed",
                    "fixedColor": "blue"
                  }
                },
                "overrides": []
              }
            }
          }
        }
      },
