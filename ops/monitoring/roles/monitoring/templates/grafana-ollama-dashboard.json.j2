                      "spec": {
                        "expr": "100 * (1 - sum(rate(ollama_host_cpu_seconds_total{host=\"arsene\",mode=\"idle\"}[$__rate_interval])) / sum(rate(ollama_host_cpu_seconds_total{host=\"arsene\"}[$__rate_interval])))",
