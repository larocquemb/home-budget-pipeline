      "panel-12": {
        "kind": "Panel",
        "spec": {
          "id": 12,
          "title": "Managed Ollama server logs",
          "description": "Startup, loads, offload, API timings and failures. Prompts and responses are not logged.",
          "links": [],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "refId": "A",
                    "hidden": false,
                    "query": {
                      "kind": "DataQuery",
                      "group": "loki",
                      "version": "v0",
                      "datasource": {
                        "name": "{{ monitoring_grafana_datasource_uid }}"
