{
  "apiVersion": "dashboard.grafana.app/v2",
  "kind": "Dashboard",
  "metadata": {
    "name": "arsene-ollama",
    "annotations": {
      "grafana.app/folder": "{{ monitoring_grafana_brown_rook_folder_uid_effective | default(monitoring_grafana_brown_rook_folder_uid) }}"
    }
  },
  "spec": {
    "annotations": [
      {
        "kind": "AnnotationQuery",
        "spec": {
          "query": {
            "kind": "DataQuery",
            "group": "grafana",
            "version": "v0",
            "datasource": {
              "name": "-- Grafana --"
            },
            "spec": {}
          },
          "enable": true,
          "hide": true,
          "iconColor": "rgba(0, 211, 255, 1)",
          "name": "Annotations & Alerts",
          "builtIn": true,
          "legacyOptions": {
            "type": "dashboard"
          }
        }
      }
    ],
    "cursorSync": "Crosshair",
    "description": "Native Ollama service, host resources, NVIDIA GPU and journal logs. Service memory is cgroup memory including cache and child runners. CPU is cores used. GPU activity is host-wide. Loaded model bytes come from api/ps. Application token throughput is retained in Home Budget Product Model Comparison, not inferred from GPU utilization.",
    "editable": false,
    "elements": {
      "panel-1": {
        "kind": "Panel",
        "spec": {
          "id": 1,
          "title": "Metric endpoint / API health",
          "links": [],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "refId": "A",
                    "hidden": false,
                    "query": {
                      "kind": "DataQuery",
                      "group": "prometheus",
                      "version": "v0",
                      "datasource": {
                        "name": "{{ monitoring_grafana_prometheus_datasource_uid }}"
                      },
                      "spec": {
                        "expr": "up{job=\"ollama-host\"}",
                        "editorMode": "code",
                        "legendFormat": "Exporter",
                        "range": false,
                        "instant": true
                      }
                    }
                  }
                },
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "refId": "B",
                    "hidden": false,
                    "query": {
                      "kind": "DataQuery",
                      "group": "prometheus",
                      "version": "v0",
                      "datasource": {
                        "name": "{{ monitoring_grafana_prometheus_datasource_uid }}"
                      },
                      "spec": {
                        "expr": "ollama_api_up{host=\"arsene\",service=\"ollama\"}",
                        "editorMode": "code",
                        "legendFormat": "Ollama API",
                        "range": false,
                        "instant": true
                      }
                    }
                  }
                }
              ],
              "transformations": [],
              "queryOptions": {}
            }
          },
          "vizConfig": {
            "kind": "VizConfig",
            "group": "stat",
            "version": "13.2.1",
            "spec": {
              "options": {
                "colorMode": "value",
                "graphMode": "area",
                "reduceOptions": {
                  "calcs": [
                    "lastNotNull"
                  ],
                  "fields": "",
                  "values": false
                }
              },
              "fieldConfig": {
                "defaults": {
                  "unit": "short"
                },
                "overrides": []
              }
            }
          },
          "description": "Managed Ollama service metrics. GPU measurements include all host workloads."
        }
      },
      "panel-2": {
        "kind": "Panel",
        "spec": {
          "id": 2,
          "title": "Ollama CPU cores used",
          "links": [],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "refId": "A",
                    "hidden": false,
                    "query": {
                      "kind": "DataQuery",
                      "group": "prometheus",
                      "version": "v0",
                      "datasource": {
                        "name": "{{ monitoring_grafana_prometheus_datasource_uid }}"
                      },
                      "spec": {
                        "expr": "rate(ollama_service_cpu_seconds_total{host=\"arsene\",service=\"ollama\"}[$__rate_interval])",
                        "editorMode": "code",
                        "legendFormat": "Service and runners",
                        "range": true,
                        "instant": false
                      }
                    }
                  }
                }
              ],
              "transformations": [],
              "queryOptions": {}
            }
          },
          "vizConfig": {
            "kind": "VizConfig",
            "group": "timeseries",
            "version": "13.2.1",
            "spec": {
              "options": {
                "legend": {
                  "displayMode": "table",
                  "placement": "bottom",
                  "showLegend": true
                },
                "tooltip": {
                  "mode": "multi",
                  "sort": "desc"
                }
              },
              "fieldConfig": {
                "defaults": {
                  "unit": "cores"
                },
                "overrides": []
              }
            }
          },
          "description": "Managed Ollama service metrics. GPU measurements include all host workloads."
        }
      },
