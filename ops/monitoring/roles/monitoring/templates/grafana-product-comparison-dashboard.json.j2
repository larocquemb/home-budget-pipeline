{
  "apiVersion": "dashboard.grafana.app/v2",
  "kind": "Dashboard",
  "metadata": {
    "name": "home-budget-enrichment-comparison",
    "annotations": {
      "grafana.app/folder": "{{ monitoring_grafana_home_budget_folder_uid_effective }}"
    }
  },
  "spec": {
    "annotations": [
      {
        "kind": "AnnotationQuery",
        "spec": {
          "query": {
            "kind": "DataQuery",
            "group": "grafana",
            "version": "v0",
            "datasource": {
              "name": "-- Grafana --"
            },
            "spec": {}
          },
          "enable": true,
          "hide": true,
          "iconColor": "rgba(0, 211, 255, 1)",
          "name": "Annotations & Alerts",
          "builtIn": true,
          "legacyOptions": {
            "type": "dashboard"
          }
        }
      }
    ],
    "cursorSync": "Crosshair",
    "description": "Shared Brave-first evidence, independent OpenAI and Qwen expansions, token/initialism/OCR evidence scores, receipt timing scope, and sampled host GPU activity. GPU activity is host-wide during Qwen requests, not exclusive process accounting. Scores are heuristic, not calibrated probabilities.",
    "editable": false,
    "elements": {
      "panel-1": {
        "kind": "Panel",
        "spec": {
          "id": 1,
          "title": "Average evidence match score",
          "links": [],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
                      "kind": "DataQuery",
                      "group": "loki",
                      "version": "v0",
                      "datasource": {
                        "name": "{{ monitoring_grafana_datasource_uid }}"
                      },
                      "spec": {
                        "editorMode": "code",
                        "expr": "avg_over_time({namespace=\"home-budget\",container=\"enrich\"} | json | line_format \"{% raw %}{{if .message}}{{.message}}{{else}}{{ __line__ }}{{end}}{% endraw %}\" | json | run_uuid=~\"${run_uuid:raw}\" | __error__=\"\" | event=\"enrichment_model_result\" | status!=\"error\" | keep provider,confidence | unwrap confidence | __error__=\"\" [$__range]) by (provider)",
                        "queryType": "instant",
                        "legendFormat": ""
                      }
                    },
                    "refId": "A",
                    "hidden": false
                  }
                }
              ],
              "transformations": [],
              "queryOptions": {}
            }
          },
          "vizConfig": {
            "kind": "VizConfig",
            "group": "stat",
            "version": "13.2.1",
            "spec": {
              "options": {
                "colorMode": "value",
                "graphMode": "none",
                "textMode": "value_and_name",
                "reduceOptions": {
                  "calcs": [
                    "lastNotNull"
                  ],
                  "fields": "",
                  "values": false
                }
              },
              "fieldConfig": {
                "defaults": {
                  "unit": "percentunit"
                },
                "overrides": []
              }
            }
          }
        }
      },
